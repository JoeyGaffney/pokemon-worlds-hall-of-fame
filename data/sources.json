    {
        "id": "worlds-2004",
        "year": 2004,
        "title": "2004 Pokémon TCG World Championships",
        "subtitle": "The First World Championships - Orlando",
        "heroImage": {
            "src": "assets/sources/2004-LOGO.png",
            "alt": "2004 Pokémon World Championships",
            "caption": "2004 Pokémon TCG World Championships."
        },
        "content": [
            {
                "type": "paragraph",
                "text": "The 2004 World Championships records were found on the wayback machine archives. Only the single elimination bracket is accessible so only data on the top 32 finishers in each age division is preserved."
            },
            {
                "type": "heading",
                "text": "Standings"
            },
            {
                "type": "paragraph",
                "text": "The archived standings page contained competitor names, countries, divisions, and tournament results. This information was used as the primary source for the 2004 database entries."
            },
            {
                "type": "image",
                "src": "assets/sources/2004-worlds-juniors.png",
                "alt": "Archived 2004 World Championships Juniors standings",
                "caption": "Archived Juniors standings from the 2004 World Championships.",
                "sourceUrl": "https://web.archive.org/web/20060104165000/http://op.pokemon-tcg.com/content/events/faqs/2003-2004/worlds/15over32cut.asp"
            },
            {
                "type": "image",
                "src": "assets/sources/2004-worlds-seniors-bracket.png",
                "alt": "Archived 2004 World Championships Seniors standings",
                "caption": "Archived Seniors standings from the 2004 World Championships.",
                "sourceUrl": "https://web.archive.org/web/20060104160255/http://op.pokemon-tcg.com/content/events/faqs/2003-2004/worlds/11to1432cut.asp"
            },
            {
                "type": "image",
                "src": "assets/sources/2004-worlds-masters-bracket.png",
                "alt": "Archived 2004 World Championships Masters standings",
                "caption": "Archived Masters standings from the 2004 World Championships.",
                 "sourceUrl": "https://web.archive.org/web/20060104165000/http://op.pokemon-tcg.com/content/events/faqs/2003-2004/worlds/15over32cut.asp"
